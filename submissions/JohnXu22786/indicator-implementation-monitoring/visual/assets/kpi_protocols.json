{
  "schema_version":"0.1.0",
  "title_zh":"PACKAGE-3886可审查概念KPI协议",
  "title_en":"Auditable concept KPI protocols for PACKAGE-3886",
  "status":"conceptual_not_current_observation",
  "baseline_policy":"Every baseline is unknown/to_verify; suggested thresholds are not current values or official standards; operator, authority and reviewer remain to_verify.",
  "evidence_record_minimum":["protocol_version","data_dictionary_version","input_receipt","authorization_or_public_source","de_identification_record","model_or_manual_method_version","human_review_decision","published_output_receipt","stop_or_rollback_record"],
  "phase_protocols":[
    {"protocol_id":"PH-NEAR","phase_zh":"近期启动 1—3年","phase_en":"Near term 1–3 years","metrics":[{"metric_id":"collection_coverage","formula":"valid_collection_batches / planned_collection_batches","suggested_threshold":{"min":0.80,"max":0.95},"baseline":"unknown/to_verify","frequency":"monthly sample; annual gate","evidence_record":["batch register","input receipts","sampling sheet","caliber sign-off"],"suggested_R":"pilot operations team (to_verify)","suggested_A":"competent authority / operator (to_verify)","failure_action":"pause public interpretation and switch to manual"},{"metric_id":"disclosure_timeliness","formula":"on_time_disclosure_batches / planned_disclosure_batches","suggested_threshold":{"min":0.80,"max":0.95},"baseline":"unknown/to_verify","frequency":"monthly; annual gate","evidence_record":["timestamp log","versioned card","human approval","public receipt"],"suggested_R":"Pavilion operator (to_verify)","suggested_A":"competent authority (to_verify)","failure_action":"withhold result and repair/re-review"},{"metric_id":"public_question_closure","formula":"on_time_closed_valid_questions / valid_questions","suggested_threshold":{"min":0.80,"max":0.95},"baseline":"unknown/to_verify","frequency":"monthly; quarterly","evidence_record":["question ledger","de-identification","reply receipt","appeal log"],"suggested_R":"community operator (to_verify)","suggested_A":"community council / authority (to_verify)","failure_action":"pause clustering and use human desk"}]},
    {"protocol_id":"PH-MID","phase_zh":"中期扩展 3—5年","phase_en":"Mid term 3–5 years","metrics":[{"metric_id":"monitoring_coverage","formula":"valid_monitoring_nodes / planned_monitoring_nodes","suggested_threshold":{"min":0.80,"max":0.95},"baseline":"unknown/to_verify","frequency":"monthly; phase gate","evidence_record":["node inventory","inspection receipts","maintenance ledger","field sign-off"],"suggested_R":"monitoring operator (to_verify)","suggested_A":"authority / site manager (to_verify)","failure_action":"retrieve failed node and publish no extrapolated coverage"},{"metric_id":"alert_precision_proxy","formula":"true_positive_reviewed_alerts / all_reviewed_alerts","suggested_threshold":{"min":0.80,"max":0.95},"baseline":"unknown/to_verify","frequency":"monthly; quarterly error review","evidence_record":["holdout","confusion matrix","drift record","human decisions"],"suggested_R":"operations/test team (to_verify)","suggested_A":"authority (to_verify)","failure_action":"stop alerts, retract output and retest"},{"metric_id":"feedback_closure","formula":"on_time_closed_valid_feedback / valid_feedback","suggested_threshold":{"min":0.80,"max":0.95},"baseline":"unknown/to_verify","frequency":"monthly; quarterly public review","evidence_record":["feedback ledger","timestamps","suppression check","appeal record"],"suggested_R":"community operator (to_verify)","suggested_A":"community council / authority (to_verify)","failure_action":"pause automated triage and publish repair status"}]},
    {"protocol_id":"PH-LONG","phase_zh":"远期常态化 5—10年","phase_en":"Long term 5–10 years","metrics":[{"metric_id":"annual_recompute_execution","formula":"completed_annual_recompute_cycles / scheduled_annual_recompute_cycles","suggested_threshold":{"value":1.0},"baseline":"unknown/to_verify","frequency":"annual; three-year review","evidence_record":["geometry version","formula package","independent recomputation","publication receipt"],"suggested_R":"professional review team (to_verify)","suggested_A":"alliance / authority (to_verify)","failure_action":"freeze dependent claims and repeat review"},{"metric_id":"suppression_compliance","formula":"compliant_low_sample_suppression_checks / sampled_suppression_checks","suggested_threshold":{"value":1.0},"baseline":"unknown/to_verify","frequency":"annual sample; incident-triggered","evidence_record":["suppression audit","access log","incident/appeal","deletion receipt"],"suggested_R":"privacy review team (to_verify)","suggested_A":"operator / authority (to_verify)","failure_action":"stop release and withdraw affected aggregate"}]}
  ],
  "annual_program_protocols":[
    {"protocol_id":"AP-01","name_zh":"年度指标开放日","name_en":"Annual Indicator Open Day","formula":"on_time_closed_questions / valid_questions","suggested_threshold":{"min":0.80,"max":0.95},"baseline":"unknown/to_verify","frequency":"event + 30-day follow-up","evidence_record":["caliber cards","question ledger","reply receipt","appeal log"],"suggested_R":"operations (to_verify)","suggested_A":"authority / operator (to_verify)","failure_action":"staffed response or cancel public display"},
    {"protocol_id":"AP-02","name_zh":"年度实施进度通报会","name_en":"Annual Implementation Progress Briefing","formula":"evidence_backed_progress_items / reported_progress_items","suggested_threshold":{"min":0.90,"max":1.00},"baseline":"unknown/to_verify","frequency":"annual + pre-publication","evidence_record":["recomputation","source ledger","zh/en review","human sign-off"],"suggested_R":"authority/operator (to_verify)","suggested_A":"professional review (to_verify)","failure_action":"defer and publish no unverified conclusion"},
    {"protocol_id":"AP-03","name_zh":"节点 B体验周","name_en":"Node B Experience Week","formula":"faults_closed_within_sla / valid_faults","suggested_threshold":{"min":0.80,"max":0.95},"baseline":"unknown/to_verify","frequency":"daily + annual review","evidence_record":["safety sheet","fault ticket","repair timestamp","retrieval record"],"suggested_R":"operations (to_verify)","suggested_A":"site manager (to_verify)","failure_action":"stop event and switch to manual observation"},
    {"protocol_id":"AP-04","name_zh":"指标方法国际交流会","name_en":"International Indicator Methods Exchange","formula":"materials_with_source_rights_and_bilingual_review / submitted_materials","suggested_threshold":{"value":1.0},"baseline":"unknown/to_verify","frequency":"pre-event and post-publication","evidence_record":["source ID","rights record","zh/en checklist","publication receipt"],"suggested_R":"editorial/university team (to_verify)","suggested_A":"operator/legal reviewer (to_verify)","failure_action":"remove item and cancel session slot"}
  ],
  "scenario_card_protocols":[
    {"card_id":"SC-01","name_zh":"指标采集聚合AI","spatial_type":"Node A + collection point","user":"operators, researchers, public reviewers","ai_capability":"align source fields and aggregate de-identified inputs","operator":"Hub operations (to_verify)","data_boundary":"public/authorized fields only; raw entry isolated; no tracking","human_gate":"source, caliber and de-identification review","exit_condition":"authorization/schema/privacy/model failure pauses model","kpi":{"formula":"valid_aligned_records / sampled_records","threshold":{"min":0.90,"max":1.00},"baseline":"unknown/to_verify","frequency":"monthly sample","evidence_record":["input receipt","schema version","de-identification","human sign-off"],"suggested_R":"operations (to_verify)","suggested_A":"professional reviewer (to_verify)","failure_action":"quarantine and recompute manually"}},
    {"card_id":"SC-02","name_zh":"实施进度监测AI","spatial_type":"Node B","user":"operators, professional teams, public reviewers","ai_capability":"classify status and expose evidence links","operator":"Post team/tester (to_verify)","data_boundary":"aggregate status; no personal profile","human_gate":"evidence/status review before publication","exit_condition":"missing evidence or drift stops auto-labeling","kpi":{"formula":"evidence_backed_status_items / sampled_status_items","threshold":{"min":0.90,"max":1.00},"baseline":"unknown/to_verify","frequency":"monthly; quarterly drift","evidence_record":["status ledger","source link","version","review receipt"],"suggested_R":"monitoring (to_verify)","suggested_A":"authority (to_verify)","failure_action":"retract label; mark unknown"}},
    {"card_id":"SC-03","name_zh":"指标偏离预警AI","spatial_type":"Node B + station interface","user":"operators and public reviewers","ai_capability":"flag aggregate deviation for human triage","operator":"operations (to_verify)","data_boundary":"street/block aggregate; no trajectory or identity","human_gate":"holdout/error review and human confirmation","exit_condition":"false-alarm gate failure stops alerts","kpi":{"formula":"true_positive_reviewed_alerts / all_reviewed_alerts","threshold":{"min":0.80,"max":0.95},"baseline":"unknown/to_verify","frequency":"monthly; quarterly error review","evidence_record":["holdout","confusion matrix","drift log","human decision"],"suggested_R":"operations/test (to_verify)","suggested_A":"authority (to_verify)","failure_action":"stop, retract and retest"}},
    {"card_id":"SC-04","name_zh":"公示解读AI","spatial_type":"Node C","user":"residents, visitors, low-digital-literacy users","ai_capability":"draft plain-language multilingual copy","operator":"Pavilion team (to_verify)","data_boundary":"public sources and approved aggregates only","human_gate":"fact, translation, accessibility and source review","exit_condition":"source/translation/accessibility failure removes copy","kpi":{"formula":"human_reviewed_correct_disclosures / sampled_disclosures","threshold":{"min":0.90,"max":1.00},"baseline":"unknown/to_verify","frequency":"each release; monthly sample","evidence_record":["source ledger","zh/en pair","review checklist","receipt"],"suggested_R":"editorial (to_verify)","suggested_A":"professional/accessibility (to_verify)","failure_action":"remove copy; revert to source card"}},
    {"card_id":"SC-05","name_zh":"公众监督反馈AI","spatial_type":"Node C + online feedback","user":"residents, community representatives, visitors","ai_capability":"cluster de-identified themes and track replies","operator":"operator + community representatives (to_verify)","data_boundary":"entry may contain personal information; de-identify before model; low-sample suppression","human_gate":"privacy, deletion, sample, reply and appeal review","exit_condition":"de-identification/access/complaint failure uses human desk","kpi":{"formula":"on_time_closed_valid_feedback / valid_feedback","threshold":{"min":0.80,"max":0.95},"baseline":"unknown/to_verify","frequency":"monthly; quarterly public review","evidence_record":["input receipt","de-identification","access log","reply/appeal"],"suggested_R":"community operator (to_verify)","suggested_A":"authority/privacy (to_verify)","failure_action":"pause clustering, delete/withdraw, human reply"}},
    {"card_id":"SC-06","name_zh":"慢行流量态势AI","spatial_type":"Slow-traffic spine + Node B","user":"walkers, cyclists, event stewards","ai_capability":"aggregate counts for time-sharing and wayfinding","operator":"Post team (to_verify)","data_boundary":"anonymous zone/time counts; no trajectory","human_gate":"count quality and safety review","exit_condition":"quality/safety failure disables adaptive prompt","kpi":{"formula":"valid_count_intervals / planned_count_intervals","threshold":{"min":0.80,"max":0.95},"baseline":"unknown/to_verify","frequency":"event-day + monthly sample","evidence_record":["count receipt","zone/time definition","safety sign-off","manual comparison"],"suggested_R":"operations (to_verify)","suggested_A":"site manager (to_verify)","failure_action":"freeze adaptive routing; use static signs"}},
    {"card_id":"SC-07","name_zh":"绿地健康度AI","spatial_type":"Green-belt park node","user":"park managers, residents, maintenance teams","ai_capability":"assist facility/vegetation inspection","operator":"park maintenance (to_verify)","data_boundary":"facility observations; no person image/tracking","human_gate":"worker confirms every recommendation","exit_condition":"misclassification/safety issue stops recommendation","kpi":{"formula":"human_confirmed_valid_maintenance_flags / sampled_flags","threshold":{"min":0.80,"max":0.95},"baseline":"unknown/to_verify","frequency":"monthly inspection","evidence_record":["inspection sheet","rights record","worker decision","repair receipt"],"suggested_R":"maintenance (to_verify)","suggested_A":"site/professional (to_verify)","failure_action":"discard and inspect manually"}},
    {"card_id":"SC-08","name_zh":"多语导览AI","spatial_type":"Node C + signage","user":"international visitors, residents, accessibility users","ai_capability":"draft multilingual indicator/culture copy","operator":"Pavilion operator (to_verify)","data_boundary":"verified public sources; no profiling","human_gate":"language, source, cultural and accessibility review","exit_condition":"unverified history or translation error removes item","kpi":{"formula":"passed_language_source_accessibility_reviews / submitted_signage_items","threshold":{"value":1.0},"baseline":"unknown/to_verify","frequency":"pre-publication; quarterly","evidence_record":["source ID","translation pair","tactile/voice check","receipt"],"suggested_R":"editorial (to_verify)","suggested_A":"language/accessibility (to_verify)","failure_action":"replace with verified card or remove sign"}},
    {"card_id":"SC-09","name_zh":"研学互动AI","spatial_type":"station learning table","user":"students, teachers, volunteers, families","ai_capability":"generate learning prompts from public records","operator":"university volunteers (to_verify)","data_boundary":"anonymous session; no account or personal record","human_gate":"teacher/volunteer safety check and alternative","exit_condition":"unsafe prompt or collection request disables model","kpi":{"formula":"safe_reviewed_learning_prompts / sampled_prompts","threshold":{"min":0.90,"max":1.00},"baseline":"unknown/to_verify","frequency":"each activity day; monthly sample","evidence_record":["prompt version","safety review","anonymous count","non-device alternative"],"suggested_R":"education team (to_verify)","suggested_A":"teacher/site (to_verify)","failure_action":"switch to printed task"}},
    {"card_id":"SC-10","name_zh":"舆情归因AI","spatial_type":"online feedback + Node C","user":"operators and community reviewers","ai_capability":"cluster de-identified themes for service improvement","operator":"operator + professional team (to_verify)","data_boundary":"de-identified text/aggregates; low-sample themes suppressed","human_gate":"privacy, sample, fairness and actionability review","exit_condition":"re-identification/bias/evidence failure stops clustering","kpi":{"formula":"human_verified_actionable_clusters / sampled_clusters","threshold":{"min":0.80,"max":0.95},"baseline":"unknown/to_verify","frequency":"monthly; quarterly fairness review","evidence_record":["de-identification","suppression audit","cluster review","action/appeal"],"suggested_R":"operator (to_verify)","suggested_A":"professional/privacy (to_verify)","failure_action":"stop, suppress output, use manual log"}}
  ],
  "industry_test_protocols":[
    {"protocol_id":"T-01","name_zh":"指标口径一致性测试","formula":"matching_sample_outputs / audited_sample_outputs","suggested_threshold":{"min":0.90,"max":1.00},"baseline":"unknown/to_verify","frequency":"before pilot and source/schema change","evidence_record":["golden sample","source/version ledger","manual adjudication","recompute receipt"],"suggested_R":"professional test team (to_verify)","suggested_A":"caliber authority (to_verify)","failure_action":"block release and repair dictionary"},
    {"protocol_id":"T-02","name_zh":"预警准确率测试","formula":"true_positive_reviewed_alerts / all_reviewed_alerts","suggested_threshold":{"min":0.80,"max":0.95},"baseline":"unknown/to_verify","frequency":"monthly and quarterly holdout","evidence_record":["holdout","confusion matrix","false-alarm log","human decisions"],"suggested_R":"operations/test team (to_verify)","suggested_A":"authority (to_verify)","failure_action":"stop alerting, retract and retest"},
    {"protocol_id":"T-03","name_zh":"公示可读性测试","formula":"participants_meeting_comprehension_criterion / valid_participants","suggested_threshold":{"min":0.80,"max":0.95},"baseline":"unknown/to_verify","frequency":"before major release; quarterly sample","evidence_record":["anonymous comprehension","language/accessibility record","human review","non-device receipt"],"suggested_R":"Pavilion/editorial team (to_verify)","suggested_A":"community/accessibility (to_verify)","failure_action":"hold release, revise and retest"}
  ]
